{
  "name": "toolbox-ts",
  "version": "0.5.2",
  "description": "my toolbox",
  "main": "dist-cjs/index.js",
  "module": "dist-esm/index.js",
  "scripts": {
    "watch": "tsc-watch",
    "test": "jest",
    "test-coverage": "jest --coverage",
    "build": "npm-run-all -s build:cjs build:esm",
    "build:cjs": "tsc --project . --module commonjs --outDir ./dist-cjs",
    "build:esm": "tsc --project . --module es2015 --outDir ./dist-esm && node scripts/finalize-esm.cjs",
    "test:package": "node scripts/verify-package.cjs",
    "prepack": "npm run clean:build && npm run build",
    "clean:build": "node scripts/clean-build.cjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lambig/toolbox-ts.git"
  },
  "author": "Lambig",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/lambig/toolbox-ts/issues"
  },
  "homepage": "https://github.com/lambig/toolbox-ts#readme",
  "devDependencies": {
    "@types/jest": "27.4.0",
    "jest": "27.4.3",
    "npm-run-all": "^4.1.5",
    "ts-jest": "^27.0.7",
    "tsc-watch": "^4.5.0",
    "typescript": "4.5.5"
  },
  "jest": {
    "moduleFileExtensions": [
      "ts",
      "js"
    ],
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "globals": {
      "ts-jest": {
        "tsConfig": "tsconfig.json"
      }
    },
    "testMatch": [
      "**/*.test.ts"
    ]
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "types": "dist-cjs/index.d.ts",
  "files": [
    "dist-cjs/",
    "dist-esm/",
    "src/"
  ]
}
